# Optional overrides for the LOCAL docker-compose.yml. Copy to .env (gitignored) and edit.
# Every value has a working default, so you only need this to change something.
#
# This is not the production configuration - that is deploy/app.env.example, which lives on
# the EC2 server and points at RDS.

# MYSQL_ROOT_PASSWORD=local-root-password
# DB_USERNAME=weekly_report
# DB_PASSWORD=local-app-password
# JWT_SECRET=local-only-jwt-secret-local-only-jwt-secret
# GEMINI_API_KEY=
# TZ=Asia/Kolkata
# FRONTEND_PORT=8081
